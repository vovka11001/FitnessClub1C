&НаКлиенте
Процедура ЗагрузитьЗаявки(Команда)
	
	Результат = ЗагрузитьЗаявкиНaСервере();
	ПоказатьПредупреждение(, Результат);
	
КонецПроцедуры

&НаСервере
Функция ЗагрузитьЗаявкиНaСервере()
	
	ИмяФайла = "C:\FitnessClubExchange\orders.json";
	
	Файл = Новый Файл(ИмяФайла); 
	
	Если НЕ Файл.Существует() Тогда
		Возврат "Файл не найден: " + ИмяФайла;
	КонецЕсли;
	
	ЧтениеJSON = Новый ЧтениеJSON;
	ЧтениеJSON.ОткрытьФайл(ИмяФайла);
	МассивЗаявок = ПрочитатьJSON(ЧтениеJSON, Ложь);
	ЧтениеJSON.Закрыть();
	
	КоличествоСозданных = 0;
	МассивОшибок = Новый Массив;
	
	Для Каждого Заявка Из МассивЗаявок Цикл
		
		ВидАбонемента = НайтиВидАбонемента(Заявка.MembershipTypeName);
		
		Если ВидАбонемента = Неопределено Тогда
			МассивОшибок.Добавить("Не найден вид абонемента """ + Заявка.MembershipTypeName + """ для клиента " + Заявка.CustomerFullName);
			Продолжить;
		КонецЕсли;
		
		Клиент = НайтиИлиСоздатьКлиента(Заявка.CustomerFullName, Заявка.CustomerPhone);
		
		НовыйДокумент = Документы.ПродажаАбонемента.СоздатьДокумент();
		НовыйДокумент.Дата = ТекущаяДата();
		НовыйДокумент.Клиент = Клиент;
		НовыйДокумент.ВидАбонемента = ВидАбонемента;
		НовыйДокумент.Сумма = ВидАбонемента.Цена;
		НовыйДокумент.Записать(РежимЗаписиДокумента.Проведение);
		
		КоличествоСозданных = КоличествоСозданных + 1;
		
	КонецЦикла;
	
	Результат = "Создано документов: " + КоличествоСозданных;
	Если МассивОшибок.Количество() > 0 Тогда
		Результат = Результат + Символы.ПС + "Ошибок: " + МассивОшибок.Количество() + Символы.ПС + СтрСоединить(МассивОшибок, Символы.ПС);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция НайтиВидАбонемента(Название)
	
	Ссылка = Справочники.ВидыАбонементов.НайтиПоНаименованию(Название, Истина);
	
	Если Ссылка.Пустая() Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат Ссылка;
	
КонецФункции

&НаСервере
Функция НайтиИлиСоздатьКлиента(Фио, Телефон)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Клиенты.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Клиенты КАК Клиенты
	|ГДЕ
	|	Клиенты.Фио = &Фио
	|	И Клиенты.Телефон = &Телефон";
	
	Запрос.УстановитьПараметр("Фио", Фио);
	Запрос.УстановитьПараметр("Телефон", Телефон);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если НЕ РезультатЗапроса.Пустой() Тогда
		Выборка = РезультатЗапроса.Выбрать();
		Выборка.Следующий();
		Возврат Выборка.Ссылка;
	КонецЕсли;
	
	НовыйКлиент = Справочники.Клиенты.СоздатьЭлемент();
	НовыйКлиент.Наименование = Фио;
	НовыйКлиент.Фио = Фио;
	НовыйКлиент.Телефон = Телефон;
	НовыйКлиент.Записать();
	
	Возврат НовыйКлиент.Ссылка;
	
КонецФункции